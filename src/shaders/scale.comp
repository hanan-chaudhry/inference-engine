#version 460

layout(local_size_x = 16) in;

layout(push_constant) uniform Params
{
    uint n;
    float alpha;
} params;
layout(set = 0, binding = 1) buffer inputA
{
    float A[];
};
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n)
        return;
    A[i] = A[i] * params.alpha;
}