#version 460

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
    uint batch;
    uint M;
    uint N;
    uint K;
    float eps;
    uint flags;
} params;

layout(std430, set = 0, binding = 0) buffer bufferA { float A[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.N) return;
    
    float x = A[i];
    A[i] = x / (1.0 + exp(-x));
}